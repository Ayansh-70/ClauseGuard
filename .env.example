# ClauseGuard Environment Configuration Example
# Copy this file to .env.local and populate with your API key if testing live models.
# IMPORTANT: Never commit .env.local to version control.
#
# NOTE: ClauseGuard runs completely offline out-of-the-box without an API key!
# When GEMINI_API_KEY is omitted (or USE_MOCK_AI=true), the system activates
# the built-in deterministic MockGeminiProvider, ensuring 100% reliable evaluation.

# Google Gemini API Key (Server-side only)
# Optional: Defaults to deterministic offline mock provider if omitted.
GEMINI_API_KEY=

# Google Gemini Model Name
# Defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# API Request Timeout (in milliseconds)
# Defaults to 30000 (30 seconds)
GEMINI_TIMEOUT_MS=30000

# Force Deterministic Mock AI Provider
# Set to 'true' to force offline evaluation regardless of API key presence.
USE_MOCK_AI=false

# Live Gemini API Integration Test Flag
# Set to 'true' to execute tests/integration/live-gemini.test.ts against the live API.
LIVE_GEMINI_TEST=false
